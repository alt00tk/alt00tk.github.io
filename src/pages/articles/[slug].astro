---
import { getCollection } from "astro:content";
import ArticlePage from "../../components/ArticlePage.astro";
import { articleLanguage, articleSlug } from "../../lib/blog";
export async function getStaticPaths() {
 return (await getCollection("blog")).filter(a => articleLanguage(a) === "ja").map(article => ({params: {slug: articleSlug(article)}, props: {article}}));
}
---
<ArticlePage article={Astro.props.article} />
