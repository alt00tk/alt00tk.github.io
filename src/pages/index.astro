---
import { getCollection } from "astro:content";
import ArticleList from "../components/ArticleList.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getArticlesForPage, getTotalPages, sortArticlesByPublishedAt } from "../lib/blog";

const articles = sortArticlesByPublishedAt(await getCollection("blog"));
const totalPages = getTotalPages(articles.length);
---

<BaseLayout title="notes">
  <main>
    <ArticleList
      articles={getArticlesForPage(articles, 1)}
      currentPage={1}
      totalPages={totalPages}
    />
  </main>
</BaseLayout>
