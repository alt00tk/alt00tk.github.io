---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  publishedAt?: string;
}

const {
  title,
  description = "技術・設計・AIについて考えたことと、判断の記録。",
  publishedAt,
} = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL("/ogp.png", Astro.site);
const imageAlt = "明るい背景に丸みのある文字でnotesと書かれ、その下に緑の線がある。";
---

<!doctype html>
<html lang="ja" prefix="og: https://ogp.me/ns# article: https://ogp.me/ns/article#">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:type" content={publishedAt ? "article" : "website"} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="notes" />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    {publishedAt && <meta property="article:published_time" content={publishedAt} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link
      href="https://fonts.googleapis.com/css2?family=Zen+Maru+Gothic:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="site">
      <header class="site-header">
        <a class="brand" href="/">notes</a>
      </header>
      <slot />
      <footer class="site-footer">© 2026 notes</footer>
    </div>
  </body>
</html>
