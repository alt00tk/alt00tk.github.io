---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  publishedAt?: string;
}

const {
  title,
  description = "技術・設計・AIについて考えたことと、判断の記録。",
  publishedAt,
} = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL("/ogp.png", Astro.site);
const imageAlt = "明るい背景に丸みのある文字でnotesと書かれ、その下に緑の線がある。";
---

<!doctype html>
<html lang="ja" prefix="og: https://ogp.me/ns# article: https://ogp.me/ns/article#">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" type="application/rss+xml" title="notes RSS" href={new URL("/rss.xml", Astro.site)} />
    <meta property="og:title" content={title} />
    <meta property="og:type" content={publishedAt ? "article" : "website"} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="notes" />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    {publishedAt && <meta property="article:published_time" content={publishedAt} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link
      href="https://fonts.googleapis.com/css2?family=Zen+Maru+Gothic:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="site">
      <header class="site-header">
        <a class="brand" href="/">notes</a>
        <div class="header-links">
          <a
            class="header-icon-link"
            href="/rss.xml"
            aria-label="記事の更新をRSSで購読する"
            title="記事の更新をRSSで購読する"
          >
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true" focusable="false">
              <circle cx="5" cy="19" r="1.5" fill="currentColor" stroke="none" />
              <path d="M4 11a9 9 0 0 1 9 9M4 4a16 16 0 0 1 16 16" />
            </svg>
          </a>
          <a
            class="header-icon-link"
            href="/llms.txt"
            aria-label="AI向けの全記事Markdown案内（llms.txt）"
            title="AI向けの全記事Markdown案内（llms.txt）"
          >
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
              <rect x="4" y="7" width="16" height="13" rx="3" />
              <path d="M12 4v3M1.5 11v5m0-2.5H4m16 0h2.5m0-2.5v5M9 16h6" />
              <circle cx="12" cy="2.5" r="1.25" fill="currentColor" stroke="none" />
              <circle cx="8.5" cy="12" r="1.25" fill="currentColor" stroke="none" />
              <circle cx="15.5" cy="12" r="1.25" fill="currentColor" stroke="none" />
            </svg>
          </a>
          <a
            class="header-icon-link"
            href="https://github.com/alt00tk/alt00tk.github.io"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="このサイトの GitHub リポジトリ（別タブで開く）"
            title="このサイトの GitHub リポジトリ（別タブで開く）"
          >
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
              <path d="M12 .75a11.25 11.25 0 0 0-3.558 21.923c.563.1.768-.244.768-.542 0-.267-.01-.974-.015-1.912-3.13.68-3.79-1.508-3.79-1.508-.511-1.3-1.249-1.646-1.249-1.646-1.021-.698.077-.684.077-.684 1.13.08 1.725 1.159 1.725 1.159 1.003 1.72 2.633 1.223 3.274.935.102-.727.392-1.223.714-1.504-2.498-.284-5.125-1.249-5.125-5.56 0-1.228.439-2.232 1.158-3.019-.116-.284-.502-1.43.11-2.978 0 0 .945-.303 3.094 1.154a10.77 10.77 0 0 1 5.634 0c2.148-1.457 3.092-1.154 3.092-1.154.614 1.548.228 2.694.112 2.978.72.787 1.157 1.791 1.157 3.02 0 4.322-2.632 5.273-5.139 5.552.404.349.765 1.038.765 2.092 0 1.511-.014 2.73-.014 3.1 0 .3.203.647.774.537A11.25 11.25 0 0 0 12 .75Z" />
            </svg>
          </a>
        </div>
      </header>
      <slot />
      <footer class="site-footer">© 2026 notes</footer>
    </div>
  </body>
</html>
