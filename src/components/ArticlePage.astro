---
import { render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { formatPublishedAt, articleLanguage, articleSlug, articleUrl, listUrl } from "../lib/blog";

const { article } = Astro.props;
const language = articleLanguage(article);
const alternate = articleUrl({ id: `${language === "en" ? "ja" : "en"}/${articleSlug(article)}` });
const { Content } = await render(article);
---

<BaseLayout
  title={`${article.data.title} — notes`}
  description={article.data.description}
  language={language}
  alternate={alternate}
  publishedAt={article.data.publishedAt}
>
  <main class:list={["site-main", { "site-main--translated": language === "en" }]}>
    {language === "en" && (
      <aside class="translation-notice" aria-label="Translation note">
        <p>This article was translated from Japanese using AI and may contain translation errors. Please refer to <a href={alternate}>the original Japanese version</a> for the author's intended meaning.</p>
      </aside>
    )}
    <article class="article">
      <header class="article-header">
        <time datetime={article.data.publishedAt}>
          {formatPublishedAt(article.data.publishedAt)}
        </time>
        <h1>{article.data.title}</h1>
        <p class="article-lead">{article.data.description}</p>
      </header>
      <div class="article-content">
        <Content />
      </div>
      <nav class="article-nav" aria-label={language === "en" ? "Article navigation" : "記事ナビゲーション"}>
        <a href={listUrl(language)}>← Articles</a>
      </nav>
    </article>
  </main>
</BaseLayout>

<script>
  import { LIST_ORIGIN, LIST_RETURN, readListContext, saveListContext } from "../lib/article-list-context";

  const returnLink = document.querySelector<HTMLAnchorElement>(".article-nav a");
  const context = readListContext(LIST_ORIGIN);
  if (returnLink && context && context.articleUrl === location.href) {
    const source = new URL(context.listUrl);
    source.hash = ""; // Referrers never include fragments; retain it in the actual return URL.
    if (document.referrer === source.href) {
      returnLink.href = context.listUrl;
      returnLink.addEventListener("click", (event) => {
        if (event.defaultPrevented || event.button !== 0 || event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
        saveListContext(LIST_RETURN, context);
      });
    }
  }

  for (const link of document.querySelectorAll<HTMLAnchorElement>(".article-content a[href]")) {
    if (
      (link.protocol === "http:" || link.protocol === "https:") &&
      link.origin !== window.location.origin
    ) {
      link.target = "_blank";
      link.relList.add("noopener");
    }
  }
</script>
